# Public values are embedded in the browser bundle at build time.
# Never put a service-role key, sb_secret key, or DB password in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Private server connection. Use the project's connection string, with URL-encoded password.
DATABASE_URL=
# Public research can be retrieved from bundled dated observations without a DB.
# Enable durable, shared official evidence after applying migration 0003.
RESEARCH_STORE_ENABLED=true
# Optional pool bound per app process (default 5; integer 1..50).
DB_MAX_CONNECTIONS=
# Number of trusted reverse proxies, counted from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Optional exact HTTPS auth aliases, comma-separated (e.g. your stable Vercel hostname).
AUTH_ALLOWED_ORIGINS=
# Optional reachable Inngest origin while DNS propagates, e.g. https://YOUR-PROJECT.vercel.app.
# Do not keep the old hosting origin when moving the Inngest app to Vercel.
INNGEST_SERVE_ORIGIN=
AI_GATEWAY_ENABLED=pixrouter,opencode,openrouter
# Keys are only sent to the matching provider host. Keep unneeded gateways disabled.
AI_FREE_ONLY=true
AI_GATEWAY_ROTATE=false
AI_DIRECT_FIRST=false
# Paid native models require AI_FREE_ONLY=false and an explicit paid preference.
# Reserved for server administration; ordinary app Auth does not need this key.
SUPABASE_SERVICE_ROLE_KEY=

# Configure at least one provider for AI generation.
# Optional self-hosted inference. Enable ollama in AI_GATEWAY_ENABLED and place
# it first in AI_GATEWAY_ORDER to prefer it. List installed, tool-capable models.
# Local inference has hardware/hosting costs; cloud models are not free by default.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODELS=
OLLAMA_FREE_MODELS=
# Remote Ollama requires HTTPS and an authenticated gateway key. Vercel's
# localhost is its own runtime, not your computer.

PIXROUTER_API_KEY=
PIXROUTER_BASE_URL=https://pixrouter.com/v1
# Includes model catalog calls; a shared rolling budget below the observed 60/hour account limit.
PIXROUTER_REQUESTS_PER_HOUR=55
PIXROUTER_FREE_MODELS=thinkingmachines/inkling:free,qwen/qwen3.8-27b:free,z-ai/glm-4.5-flash:free,openrouter/free
PIXROUTER_MODELS=thinkingmachines/inkling:free,qwen/qwen3.8-27b:free,z-ai/glm-4.5-flash:free,openrouter/free

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_FREE_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free,mimo-v2.6-flash-free,nemotron-3.5-super-vl-free,big-pickle
OPENCODE_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free,mimo-v2.6-flash-free,nemotron-3.5-super-vl-free,big-pickle

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides; empty values use defaults in src/lib/ai/generate.ts.
OPENROUTER_FREE_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
OPENROUTER_CUSTOM_MODEL=
OPENAI_AI_MODEL=
GOOGLE_AI_MODEL=
ANTHROPIC_AI_MODEL=
# Optional compatible gateways; configure a key to enable each profile.
# kios OpenAI-compatible gateway. Keys stay server-side.
KIOS_API_KEY=
KIOS_BASE_URL=https://kiosapi.com/v1
KIOS_MODELS=agnes-3.0-flash,glm-5.3-flash-free,atria-dawn-preview,step-5-preview-free,qwen3.8-flash-free
# Explicit free-only allowlist; confirm these models are free with the provider.
KIOS_FREE_MODELS=glm-5.3-flash-free,step-5-preview-free,qwen3.8-flash-free

# seekai OpenAI-compatible gateway. Keys stay server-side.
SEEKAI_API_KEY=
SEEKAI_BASE_URL=https://seekai.cc/v1
SEEKAI_MODELS=minimax-m2.7:free,moonshotai/kimi-k3,MiniMax-M2.7-highspeed,claude-sonnet-4-6,claude-sonnet-4-20250514,deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-v4.1-flash
# Explicit free-only allowlist; confirm these models are free with the provider.
SEEKAI_FREE_MODELS=minimax-m2.7:free

# agentrouter OpenAI-compatible gateway. Keys stay server-side.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODELS=deepseek-v4-flash
# Explicit free-only allowlist; confirm these models are free with the provider.
AGENTROUTER_FREE_MODELS=
AI_GATEWAY_ORDER=pixrouter,opencode,openrouter
# Set true only while diagnosing model failures; logs contain metadata, never prompts/keys.
AI_DIAGNOSTICS=false
# Optional agent preferences; only IDs already in the configured model lists are used.
AI_AGENT_MARKET_MODELS=
AI_AGENT_CUSTOMER_MODELS=
AI_AGENT_COMPETITOR_MODELS=
AI_AGENT_FINANCE_MODELS=
AI_AGENT_RISK_MODELS=
AI_AGENT_EVIDENCE_MODELS=
AI_AGENT_PRODUCT_MODELS=
AI_AGENT_GROWTH_MODELS=
AI_AGENT_SYNTHESIS_MODELS=

# Public search is tried first; agent-requested keyed search is a bounded fallback.
# Server-private public-source memory is dated, scoped and expires automatically.
MARKET_MEMORY_ENABLED=true
# Cached results are reused for six hours. Production requires Redis for keyed calls.
SEARXNG_BASE_URL=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARCH_KEYED_ENABLED=true
SEARCH_PROVIDER_ORDER=tavily,serper,serpapi
SEARCH_KEYED_MAX_PER_REPORT=2
SEARCH_KEYED_DAILY_LIMIT=30

# Required in production for signup and costly API rate/concurrency limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exactly 64 hexadecimal characters (32 random bytes); required for storing custom AI keys.
ENCRYPTION_KEY=
# Bearer token used by the credit-reset cron; empty blocks the endpoint.
CRON_SECRET=

# Local uses Next.js after(); production validation requires inngest.
VALIDATION_RUNNER=local
# Concurrent durable jobs across users; default 2, range 1..50. Keep low on free hosting.
VALIDATION_GLOBAL_CONCURRENCY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only with a local Inngest dev server, never in production.
INNGEST_DEV=

# Stripe: leave empty until configured; checkout fails gracefully when absent.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_MAX_PREMIUM_PRICE_ID=

# Razorpay webhook support exists; Razorpay checkout is not enabled yet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREMIUM_PLAN_ID=
RAZORPAY_MAX_PREMIUM_PLAN_ID=
