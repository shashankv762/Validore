# Public values are embedded in the browser bundle at build time.
# Never put a service-role key, sb_secret key, or DB password in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
# Set production for a public release; preview blocks search indexing at build time.
APP_ENV=development
# Optional reviewed Git revision, set as a runtime variable for /api/health.
BUILD_COMMIT_SHA=
# Optional exact HTTPS origins for the public health check only.
HEALTH_CHECK_ALLOWED_ORIGINS=

DATABASE_URL=
# Enables shared public research storage after migration 0003.
RESEARCH_STORE_ENABLED=true
# Pool limit per Node process (1–50).
DB_MAX_CONNECTIONS=2
# Trusted reverse proxies, counted from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Registrations per network in seven days (1–20).
SIGNUP_MAX_PER_IP_WEEK=3
# Optional exact HTTPS auth origins, comma-separated.
AUTH_ALLOWED_ORIGINS=
INNGEST_SERVE_ORIGIN=
AI_GATEWAY_ENABLED=pixrouter,opencode,openrouter
# Keys are only sent to the matching provider host. Keep unneeded gateways disabled.
AI_FREE_ONLY=true
# To use explicit unknown-priced workspace gateway aliases, both flags are required:
# AI_FREE_ONLY=false and AI_WORKSPACE_MODEL_POLICY=operator_funded.
# This never enables paid checkout; FREE_MODELS must contain confirmed free IDs only.
AI_WORKSPACE_MODEL_POLICY=free_only
AI_GATEWAY_ROTATE=false
AI_DIRECT_FIRST=false
# Paid native models require AI_FREE_ONLY=false and an explicit paid preference.
# Server-only Auth admin key. Never use either value in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure at least one provider for AI generation.
# Optional self-hosted inference. Enable ollama in AI_GATEWAY_ENABLED and place
# it first in AI_GATEWAY_ORDER to prefer it. List installed, tool-capable models.
# Local inference has hardware/hosting costs; cloud models are not free by default.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODELS=
OLLAMA_FREE_MODELS=
# A remote Ollama endpoint requires HTTPS and an authenticated gateway key.

PIXROUTER_API_KEY=
PIXROUTER_BASE_URL=https://pixrouter.com/v1
# Includes model catalog calls; a shared rolling budget below the observed 60/hour account limit.
PIXROUTER_REQUESTS_PER_HOUR=55
# Blank uses the adapter's default low reasoning effort.
PIXROUTER_REASONING_EFFORT=
PIXROUTER_FREE_MODELS=thinkingmachines/inkling:free,qwen/qwen3.8-27b:free,z-ai/glm-4.5-flash:free,openrouter/free
PIXROUTER_MODELS=thinkingmachines/inkling:free,qwen/qwen3.8-27b:free,z-ai/glm-4.5-flash:free,openrouter/free

OPENCODE_API_KEY=
OPENCODE_REASONING_EFFORT=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_FREE_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free,mimo-v2.6-flash-free,nemotron-3.5-super-vl-free,big-pickle
OPENCODE_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free,mimo-v2.6-flash-free,nemotron-3.5-super-vl-free,big-pickle

OPENROUTER_API_KEY=
OPENROUTER_REASONING_EFFORT=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Native provider model IDs must be set explicitly; blank disables that native path.
# Use the provider's API model ID, not a Codex worker name such as gpt-6-astra.
OPENROUTER_FREE_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
OPENROUTER_CUSTOM_MODEL=
OPENAI_AI_MODEL=
GOOGLE_AI_MODEL=
ANTHROPIC_AI_MODEL=
# Optional compatible gateways; configure a key to enable each profile.
# kios OpenAI-compatible gateway. Keys stay server-side.
KIOS_API_KEY=
KIOS_BASE_URL=https://kiosapi.com/v1
KIOS_MODELS=agnes-3.0-flash,glm-5.3-flash-free,atria-dawn-preview,step-5-preview-free,qwen3.8-flash-free
# Explicit free-only allowlist; confirm these models are free with the provider.
KIOS_FREE_MODELS=glm-5.3-flash-free,step-5-preview-free,qwen3.8-flash-free

# seekai OpenAI-compatible gateway. Keys stay server-side.
SEEKAI_API_KEY=
SEEKAI_BASE_URL=https://seekai.cc/v1
SEEKAI_MODELS=minimax-m2.7:free,moonshotai/kimi-k3,MiniMax-M2.7-highspeed,claude-sonnet-4-6,claude-sonnet-4-20250514,deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-v4.1-flash
# Explicit free-only allowlist; confirm these models are free with the provider.
SEEKAI_FREE_MODELS=minimax-m2.7:free

# agentrouter OpenAI-compatible gateway. Keys stay server-side.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODELS=deepseek-v4-flash
# Explicit free-only allowlist; confirm these models are free with the provider.
AGENTROUTER_FREE_MODELS=
# Additional gateways are disabled until explicitly enabled with their own key
# and model allowlist. Blank protocol uses the supported profile default.
# Do not infer model prices or native API identity from gateway alias names.
# FreeGG: Responses only; Chat Completions/Messages are not supported on this host.
FREEGG_API_KEY=
FREEGG_BASE_URL=https://freegg.app/v1
FREEGG_MODELS=
FREEGG_FREE_MODELS=
FREEGG_PROTOCOL=
FREEGG_REASONING_EFFORT=
FREEGG_REQUESTS_PER_HOUR=

# UTIM: OpenAI Chat Completions. The small-budget DeepSeek alias defaults to low.
UTIM_API_KEY=
UTIM_BASE_URL=https://api.utim.dev/v1
UTIM_MODELS=
UTIM_FREE_MODELS=
UTIM_PROTOCOL=
UTIM_REASONING_EFFORT=
UTIM_REQUESTS_PER_HOUR=

# Qronos: Anthropic Messages only. Blank auth mode means api_key;
# bearer is explicit and requires provider acceptance. OpenAI effort is omitted.
QRONOS_API_KEY=
QRONOS_BASE_URL=https://qronos.me/v1
QRONOS_MODELS=
QRONOS_FREE_MODELS=
QRONOS_PROTOCOL=
QRONOS_ANTHROPIC_AUTH_MODE=
QRONOS_REASONING_EFFORT=
QRONOS_REQUESTS_PER_HOUR=

# ArtBloom: openai (default) or anthropic. Confirm model/protocol access first.
ARTBLOOM_API_KEY=
ARTBLOOM_BASE_URL=https://api.artbloom.tech/v1
ARTBLOOM_MODELS=
ARTBLOOM_FREE_MODELS=
ARTBLOOM_PROTOCOL=
ARTBLOOM_ANTHROPIC_AUTH_MODE=
ARTBLOOM_REASONING_EFFORT=
ARTBLOOM_REQUESTS_PER_HOUR=

# These profiles require an operator-supplied HTTPS base URL and confirmed models.
APINEX_API_KEY=
APINEX_BASE_URL=
APINEX_MODELS=
APINEX_FREE_MODELS=
APINEX_PROTOCOL=
APINEX_REASONING_EFFORT=
APINEX_REQUESTS_PER_HOUR=

ORCA_API_KEY=
ORCA_BASE_URL=
ORCA_MODELS=
ORCA_FREE_MODELS=
ORCA_PROTOCOL=
ORCA_REASONING_EFFORT=
ORCA_REQUESTS_PER_HOUR=
# Optional reasoning values: none, minimal, low, medium, high, xhigh, max.
# Provider/protocol support must be verified; an application hourly cap does not
# increase upstream funding or quota. Keep unused keys and all new model slots blank.
AI_GATEWAY_ORDER=pixrouter,opencode,openrouter
# Set true only while diagnosing model failures; logs contain metadata, never prompts/keys.
AI_DIAGNOSTICS=false
# Optional agent preferences; only IDs already in the configured model lists are used.
AI_AGENT_MARKET_MODELS=
AI_AGENT_CUSTOMER_MODELS=
AI_AGENT_COMPETITOR_MODELS=
AI_AGENT_FINANCE_MODELS=
AI_AGENT_RISK_MODELS=
AI_AGENT_EVIDENCE_MODELS=
AI_AGENT_PRODUCT_MODELS=
AI_AGENT_GROWTH_MODELS=
AI_AGENT_SYNTHESIS_MODELS=
# Bounds durable specialist batches; default 1 for free gateways, 3 for paid.
# Range 1..5. Raise only after verifying provider and host capacity.
AI_SPECIALIST_CONCURRENCY=
# Optional role-specific native overrides use AI_AGENT_<ROLE>_<PROVIDER>_MODEL,
# e.g. AI_AGENT_MARKET_GOOGLE_MODEL. Providers: OPENAI, GOOGLE, ANTHROPIC.

# Public search is tried first; agent-requested keyed search is a bounded fallback.
# Server-private public-source memory is dated, scoped and expires automatically.
MARKET_MEMORY_ENABLED=true
# Cached results are reused for six hours. Production requires Redis for keyed calls.
SEARXNG_BASE_URL=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARCH_KEYED_ENABLED=true
SEARCH_PROVIDER_ORDER=tavily,serper,serpapi
SEARCH_KEYED_MAX_PER_REPORT=2
SEARCH_KEYED_DAILY_LIMIT=30

# Required in production for signup and costly API rate/concurrency limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exactly 64 hexadecimal characters (32 random bytes); required for storing custom AI keys.
ENCRYPTION_KEY=
# Render uses Inngest for scheduled credit and retention maintenance.
CREDIT_MAINTENANCE_RUNNER=
# Optional bearer token for /api/cron/reset-credits. Inngest does not use it.
CRON_SECRET=

# Optional AppLixir rewarded video. Apply migration 0004 even when disabled.
# Enable only after publisher approval, signed-callback setup and live testing.
REWARDED_ADS_ENABLED=false
# Public placement key (not a secret); game ID is numeric.
APPLIXIR_API_KEY=
APPLIXIR_GAME_ID=
# Private random 32+ character secret. Use dashboard webhook mode "MD5 and TID".
APPLIXIR_S2S_SECRET=
# Every confirmed ad earns exactly 10 credits. Caps include pending reservations.
REWARDED_ADS_DAILY_LIMIT=5
REWARDED_ADS_GLOBAL_DAILY_LIMIT=50

# Local uses Next.js after(); production validation requires inngest.
VALIDATION_RUNNER=local
# Concurrent durable jobs across users; default 2, range 1..50. Keep low on free hosting.
VALIDATION_GLOBAL_CONCURRENCY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only with a local Inngest dev server, never in production.
INNGEST_DEV=

# Starting credits (200 once) and daily claims (10/UTC day) require migration 0007.
# Owner-assigned plans work while paid checkout is disabled.
ENABLE_PAID_CHECKOUT=false
# Stripe sales also require this enable flag, valid credentials and reviewed prices.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly USD base prices ($8 and $20) with matching INR options (₹799 and ₹1,999).
STRIPE_PREMIUM_PRICE_ID=
STRIPE_MAX_PREMIUM_PRICE_ID=
# Existing subscribers need an active invoice/cancellation portal with subscription updates disabled.
STRIPE_SERVICE_PORTAL_CONFIGURATION_ID=

# Razorpay webhook support exists; Razorpay checkout is not enabled yet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREMIUM_PLAN_ID=
RAZORPAY_MAX_PREMIUM_PLAN_ID=
