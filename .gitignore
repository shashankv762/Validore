# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CI/CD artifacts (generated by Jenkins pipeline, not committed)
/reports/
/.trivy-cache/
/coverage/

# Docker artifacts
docker-compose.override.yml

# Firebase
firebase-debug.log

# Python scripts output
*.pyc
__pycache__/

# Agent logs & local trash
.agents/
.rbxsync-trash/
/*.py
