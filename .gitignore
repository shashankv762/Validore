# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
**/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
service_account*.json
*.dump
*.dump.gz
*.sql.gz

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Local environment files; track only the sanitized example.
.env*
!.env.example
!.env.production.example

# Cloudflare generated output and local runtime credentials
/.open-next/
/.wrangler/
/.dev.vars*
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Local verification reports, caches, and temporary packaging artifacts
/reports/
/.trivy-cache/
/.npm-cache/
/.tmp/
/tmp/
/.docker-auth.*/
*.tmp

# Docker artifacts
docker-compose.override.yml

# Firebase
firebase-debug.log

# Python scripts output
*.pyc
__pycache__/
.venv/
venv/

# Portable classroom tools, local credentials and workspaces
/.classroom/

# Agent logs & local trash
.agents/
.rbxsync-trash/

# Local one-off source repair helpers (not application source)
/fix_routes.py
/fix_syntax.py
/reconstruct_reportview.py
/replace_sections.py
/wrap_appended.py
